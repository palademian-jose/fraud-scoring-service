# Paths (defaults are relative to the repo root)
DATA_PATH=data/raw/creditcard.parquet
SAMPLE_PATH=data/sample/creditcard_sample.parquet
MODELS_DIR=models
REPORTS_DIR=reports
MONITORING_CONFIG=monitoring.yaml

# Alert economics: cost of reviewing a legitimate alert vs average loss on a missed fraud
COST_FP=5.0
COST_FN=150.0

# Modelling
SEED=42
SHAP_BACKGROUND_ROWS=2000
BOOTSTRAP_RESAMPLES=1000

# Serving
MAX_BATCH=1000
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=100
P95_LATENCY_BUDGET_MS=50
